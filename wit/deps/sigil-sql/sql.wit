package sigil:sql@0.2.0;

/// Experimental typed SQL driver surface. It grants no host authority.
interface driver {
    /// Caller input is a set of additional ceilings. A driver must combine
    /// each present limit with every smaller fixed or operator-owned limit.
    record connect-options {
        endpoint: string,
        username-secret: string,
        password-secret: string,
        database: option<string>,
        max-rows: option<u32>,
        max-result-bytes: option<u64>,
    }

    enum error-class {
        invalid,
        authentication,
        server,
        transport,
        protocol,
        encoding,
        limit,
        timeout,
        closed,
        unsupported,
    }

    record error {
        class: error-class,
        vendor-code: option<u32>,
        sqlstate: option<string>,
        message: string,
    }

    /// The semantic value class for one ordered result column.
    enum column-type {
        null,
        signed,
        unsigned,
        floating,
        decimal,
        text,
        bytes,
        temporal,
    }

    /// The source temporal class. Cell text remains byte-for-byte unchanged.
    enum temporal-type {
        date,
        time,
        time-with-time-zone,
        datetime,
        timestamp,
        timestamp-with-time-zone,
        interval,
        year,
        vendor,
    }

    /// A tagged SQL value. `null` has no payload. `decimal` and `temporal`
    /// carry their exact UTF-8 wire lexemes and are never normalized.
    variant cell {
        null,
        signed(s64),
        unsigned(u64),
        floating(f64),
        decimal(string),
        text(string),
        bytes(list<u8>),
        temporal(string),
    }

    /// Ordered metadata for one positional cell in every returned row.
    record column {
        catalog: string,
        schema: string,
        table: string,
        original-table: string,
        name: string,
        original-name: string,
        vendor-type: u32,
        charset: u32,
        collation: u32,
        %flags: u32,
        %type: column-type,
        temporal-type: option<temporal-type>,
    }

    record row {
        cells: list<cell>,
    }

    record row-set {
        columns: list<column>,
        rows: list<row>,
    }

    /// Command metadata reported by the server protocol.
    record command-result {
        affected-rows: u64,
        last-insert-id: option<u64>,
        warnings: u32,
    }

    /// One resource is one server session until close or terminal failure.
    resource connection {
        /// Execute one statement that returns exactly one row set.
        query: func(sql: string) -> result<row-set, error>;

        /// Execute one statement that returns exactly one command result.
        exec: func(sql: string) -> result<command-result, error>;

        /// Close the session. Repeated calls have no effect.
        close: func();
    }

    connect: func(options: connect-options) -> result<connection, error>;
}

/// Binding-only world. Plugin manifests still select the nominal `driver`
/// interface as their entrypoint.
world bindings {
    export driver;
}
